#!/usr/bin/env node
// Launcher for the bridge. Installed either as an npm binary (bin/uitalk.cmd wraps
// this for native Windows shells) or as a Claude Code plugin, whose bin/ directory
// is put on PATH — so the skill can start it without knowing where it lives.
//
//   uitalk              # start detached, print the URL, exit
//   uitalk --dev "npm run dev"   # run the dev server detached too
//   uitalk --app-port 3000
//   uitalk --fg         # run in the foreground (Ctrl-C to stop)
//   uitalk --status     # is one running for this project?
//   uitalk --stop       # stop the one serving this project
//   uitalk --list       # every bridge running
//
// Who answers the panel:
//   uitalk                        # the built-in Claude session (default)
//   uitalk --no-agent             # nobody: drive the page from an MCP client
//   uitalk --agent adapter        # your own model, over its HTTP API
//   uitalk --agent adapter --provider gemini --model gemini-2.5-pro
//
// The adapter reads its key from $UITALK_API_KEY, the provider's own variable
// ($OPENAI_API_KEY, $ANTHROPIC_API_KEY, $GEMINI_API_KEY), or
// ~/.uitalk/credentials.json. Never pass a key as an argument: it would be in
// your shell history.
//
// Detached is the default on purpose. A bridge has to outlive the shell that
// started it: started as a background job of an agent's shell it is reaped when
// that shell goes away, which kills the session mid-edit.
//
// This is plain Node rather than a shell script so the same file runs unchanged on
// Linux, macOS and native Windows (cmd.exe / PowerShell, no WSL or Git Bash
// required) — a shell script cannot do that, since Windows has no bash and no
// POSIX process groups.

import { spawn, execFileSync } from "node:child_process";
import { createConnection } from "node:net";
import {
  existsSync, mkdirSync, openSync, readFileSync, writeFileSync, unlinkSync,
  realpathSync,
} from "node:fs";
import { homedir } from "node:os";
import { dirname, join, basename, resolve as resolvePath } from "node:path";
import { fileURLToPath } from "node:url";

const WIN = process.platform === "win32";

// Resolved to the real file (following symlinks) so an npm link or the plugin
// symlink both find the install root correctly, the way `readlink -f` did in the
// old bash launcher.
const SELF = realpathSync(fileURLToPath(import.meta.url));
const ROOT = dirname(dirname(SELF));

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

/** A quick, non-hanging check: does anything accept a connection on this port? */
function portOpen(port, host = "127.0.0.1") {
  return new Promise((done) => {
    const sock = createConnection({ host, port, timeout: 300 });
    const finish = (ok) => {
      sock.destroy();
      done(ok);
    };
    sock.once("connect", () => finish(true));
    sock.once("timeout", () => finish(false));
    sock.once("error", () => finish(false));
  });
}

const alive = (pid) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
};

/** Kill a process and, where the platform supports it, everything under it. */
function killTree(pid, signal = "SIGTERM") {
  if (WIN) {
    try {
      execFileSync("taskkill", ["/pid", String(pid), "/t", "/f"], { stdio: "ignore" });
    } catch {}
    return;
  }
  // detached:true on POSIX makes the child a process-group leader, so the negative
  // pid reaches the whole tree (a dev server's own children included).
  try {
    process.kill(-pid, signal);
  } catch {
    try {
      process.kill(pid, signal);
    } catch {}
  }
}

// bash -lc sources the user's profile (nvm, asdf, PATH tweaks a dev command may
// need) the same way the old launcher's login shell did. Fall back to a plain
// shell where bash is not installed, and to cmd.exe on Windows.
const HAS_BASH = !WIN && (() => {
  try {
    execFileSync("bash", ["-c", "exit 0"], { stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
})();

function spawnShell(command, opts) {
  if (WIN) return spawn(command, { ...opts, shell: true });
  if (HAS_BASH) return spawn("bash", ["-lc", command], opts);
  return spawn(command, { ...opts, shell: true });
}

function tailLines(path, n) {
  try {
    const lines = readFileSync(path, "utf8").split("\n");
    return lines.slice(-n - 1).join("\n");
  } catch {
    return "";
  }
}

function help() {
  const lines = readFileSync(SELF, "utf8").split("\n");
  const out = [];
  for (const line of lines.slice(1)) {
    if (!line.startsWith("//")) break;
    out.push(line.replace(/^\/\/ ?/, ""));
  }
  console.log(out.join("\n"));
}

// ------------------------------------------------------------------- arguments

const HOME_DIR = process.env.UITALK_HOME || join(homedir(), ".uitalk");
const LOG_DIR = join(HOME_DIR, "logs");
const CANDIDATES = [5173, 5174, 5175, 5176, 3000, 3001, 4200, 8080, 8000, 1313];

let project = process.cwd();
let appPort = process.env.UITALK_APP_PORT || "";
let devCmd = "";
let mode = "start";
let agent = process.env.UITALK_AGENT || "";
let provider = process.env.UITALK_AGENT_PROVIDER || "";
let model = process.env.UITALK_AGENT_MODEL || "";
let baseUrl = process.env.UITALK_AGENT_BASE_URL || "";

const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  const next = () => argv[++i];
  switch (a) {
    case "--app-port": appPort = next(); break;
    case "--dev": devCmd = next(); break;
    case "--project": project = next(); break;
    case "--agent": agent = next(); break;
    case "--no-agent": agent = "off"; break;
    case "--provider": provider = next(); break;
    case "--model": model = next(); break;
    case "--base-url": baseUrl = next(); break;
    case "--fg": mode = "fg"; break;
    case "--status": mode = "status"; break;
    case "--stop": mode = "stop"; break;
    case "--list": {
      const { list } = await import(join(ROOT, "server", "registry.mjs"));
      const running = list();
      if (!running.length) console.log("no bridges running");
      for (const e of running) {
        console.log(`  :${e.port} -> ${e.appHost}:${e.appPort}  pid ${e.pid}  ${e.project}`);
      }
      process.exit(0);
      break;
    }
    case "-h":
    case "--help":
      help();
      process.exit(0);
      break;
    default:
      console.error(`[uitalk] unknown option: ${a}`);
      process.exit(2);
  }
}

if (!["builtin", "adapter", "off"].includes(agent || "builtin")) {
  console.error(`[uitalk] --agent must be builtin, adapter or off (got: ${agent})`);
  process.exit(2);
}

try {
  project = realpathSync(resolvePath(project));
} catch (err) {
  console.error(`[uitalk] cannot use project directory ${project}: ${err.message}`);
  process.exit(1);
}

const { list: registryList } = await import(join(ROOT, "server", "registry.mjs"));
const running = () => registryList().find((e) => e.project === project);

const devPidfile = () => join(LOG_DIR, `${basename(project)}-dev.pid`);
const devRunning = () => {
  const f = devPidfile();
  if (!existsSync(f)) return null;
  const pid = Number(readFileSync(f, "utf8").trim());
  return alive(pid) ? pid : null;
};

function stopDev() {
  const f = devPidfile();
  const pid = devRunning();
  if (pid) {
    killTree(pid);
    console.log(`[uitalk] stopped the dev server (pid ${pid})`);
  }
  try {
    unlinkSync(f);
  } catch {}
}

async function startDev() {
  mkdirSync(LOG_DIR, { recursive: true });
  const logPath = join(LOG_DIR, `${basename(project)}-dev.log`);
  const f = devPidfile();

  const already = devRunning();
  if (already) {
    console.error(`[uitalk] a dev server this bridge started is already running (pid ${already})`);
    return true;
  }

  console.error(`[uitalk] starting: ${devCmd}`);
  const fd = openSync(logPath, "a");
  const child = spawnShell(devCmd, { cwd: project, detached: true, stdio: ["ignore", fd, fd] });
  writeFileSync(f, String(child.pid));
  child.unref();
  console.error(`[uitalk] dev log: ${logPath}`);

  for (let waited = 0; waited < 120; waited++) {
    if (appPort) {
      if (await portOpen(Number(appPort))) return true;
    } else {
      for (const c of CANDIDATES) {
        if (await portOpen(c)) {
          appPort = String(c);
          console.error(`[uitalk] dev server came up on :${c}`);
          return true;
        }
      }
    }
    await sleep(500);
  }

  console.error(`[uitalk] the dev server did not start listening within 60s. Last lines of ${logPath}:`);
  console.error(tailLines(logPath, 20));
  return false;
}

// ------------------------------------------------------------------------ modes

if (mode === "status") {
  const info = running();
  if (info) {
    console.log(`[uitalk] running: pid ${info.pid} at http://127.0.0.1:${info.port} -> :${info.appPort}`);
    const devPid = devRunning();
    if (devPid) {
      console.log(`[uitalk] dev server: pid ${devPid} (started by this bridge)`);
    } else if (await portOpen(info.appPort)) {
      console.log(`[uitalk] dev server on :${info.appPort} is up (started elsewhere)`);
    } else {
      console.log(`[uitalk] WARNING nothing is listening on :${info.appPort}`);
    }
    process.exit(0);
  }
  const devPid = devRunning();
  if (devPid) console.log(`[uitalk] dev server: pid ${devPid}`);
  console.log(`[uitalk] nothing running for ${project}`);
  process.exit(1);
}

if (mode === "stop") {
  stopDev();
  const info = running();
  if (!info) {
    console.log(`[uitalk] no bridge running for ${project}`);
    process.exit(0);
  }
  try {
    process.kill(info.pid);
  } catch {}
  console.log(`[uitalk] stopped pid ${info.pid}`);
  process.exit(0);
}

// Already serving this project: hand back the existing URL rather than racing it.
{
  const info = running();
  if (info) {
    console.log(`[uitalk] already running at http://127.0.0.1:${info.port} (pid ${info.pid})`);
    console.log(`[uitalk] split screen: http://127.0.0.1:${info.port}/__uitalk/shell`);
    process.exit(0);
  }
}

if (devCmd) {
  if (!(await startDev())) process.exit(1);
}

if (!appPort) {
  for (const candidate of CANDIDATES) {
    if (await portOpen(candidate)) {
      appPort = String(candidate);
      console.error(`[uitalk] found a server on :${appPort}`);
      break;
    }
  }
}

if (!appPort) {
  console.error(
    "[uitalk] No dev server found on the usual ports.\n" +
      "              Start your app first, then either re-run this or pass the port:\n" +
      "                uitalk --app-port 4321",
  );
  process.exit(1);
}

const env = { ...process.env, UITALK_PROJECT: project, UITALK_APP_PORT: appPort };
// Only set what was asked for: an empty value would override the settings file
// with "", and lose a project's own choice.
if (agent) env.UITALK_AGENT = agent;
if (provider) env.UITALK_AGENT_PROVIDER = provider;
if (model) env.UITALK_AGENT_MODEL = model;
if (baseUrl) env.UITALK_AGENT_BASE_URL = baseUrl;

const serverEntry = join(ROOT, "server", "index.mjs");

if (mode === "fg") {
  const child = spawn(process.execPath, [serverEntry], { env, stdio: "inherit" });
  for (const sig of ["SIGINT", "SIGTERM"]) {
    process.on(sig, () => child.kill(sig));
  }
  child.on("exit", (code, signal) => process.exit(code ?? (signal ? 1 : 0)));
} else {
  mkdirSync(LOG_DIR, { recursive: true });
  const logPath = join(LOG_DIR, `${basename(project)}.log`);
  const fd = openSync(logPath, "a");
  // Fully detached: new session (POSIX) or no console (Windows), stdin closed,
  // output to the log. A signal aimed at the caller's shell cannot reach it here.
  const child = spawn(process.execPath, [serverEntry], {
    env, detached: true, stdio: ["ignore", fd, fd],
  });
  child.unref();

  let found = null;
  for (let i = 0; i < 40 && !found; i++) {
    found = running();
    if (!found) await sleep(250);
  }

  if (found) {
    console.log(`[uitalk] http://127.0.0.1:${found.port}  (pid ${found.pid}, proxying :${found.appPort})`);
    console.log(`[uitalk] split screen: http://127.0.0.1:${found.port}/__uitalk/shell`);
    console.log(`[uitalk] log: ${logPath}`);
    process.exit(0);
  }

  console.error(`[uitalk] it did not come up in 10s. Last lines of ${logPath}:`);
  console.error(tailLines(logPath, 15));
  process.exit(1);
}
